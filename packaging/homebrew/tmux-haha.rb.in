class TmuxHaha < Formula
  desc "Find, start and switch tmux sessions from one small command: ta"
  homepage "https://github.com/larrykoo711/tmux-haha"
  license "MIT"

  depends_on "tmux"

  on_macos do
    on_arm do
      url "https://github.com/larrykoo711/tmux-haha/releases/download/v@VERSION@/tmux-haha-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_ARM@"
    end
    on_intel do
      url "https://github.com/larrykoo711/tmux-haha/releases/download/v@VERSION@/tmux-haha-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_X64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/larrykoo711/tmux-haha/releases/download/v@VERSION@/tmux-haha-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://github.com/larrykoo711/tmux-haha/releases/download/v@VERSION@/tmux-haha-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_X64@"
    end
  end

  def install
    bin.install "ta"
  end

  def caveats
    <<~EOS
      Run `ta` to open the session picker, or `ta <name>` to go straight to a session.
      ta changes no global tmux settings; optional config: ~/.config/ta/config.toml
    EOS
  end

  test do
    assert_match "ta #{version}", shell_output("#{bin}/ta --version")
  end
end
